# Backend API (FastAPI/Flask on localhost:5000 by default; see config/settings.py)
BACKEND_URL=http://localhost:5000

# Shared secret matching INTERNAL_API_KEY in repo-root .env (read by backend at startup).
# NEVER prefix this with NEXT_PUBLIC_ — it must stay server-side only.
INTERNAL_API_KEY=

# Optional: timeout (ms) for backend round-trip from route handler
BACKEND_TIMEOUT_MS=120000

# Optional MapLibre style URL override.
# Default (khi để trống): OpenFreeMap Liberty — miễn phí, không key, không quota.
# Có thể cắm MapTiler / VietMap / Mapbox style JSON nếu muốn POI/labels dày hơn.
# Public — bundled to client. Với provider có key, nhớ restrict by referrer.
NEXT_PUBLIC_MAP_STYLE_URL=
