# ── API Keys (Required) ───────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key-here
PG_URI=postgresql://postgres:postgres@localhost:5432/travel_db
INTERNAL_API_KEY=your-long-and-random-secret-here

# ── HuggingFace Hub ───────────────────────────────────────────────
# Skip HF metadata check on startup (model is cached locally) — faster boot,
# silences "unauthenticated requests" warning. Disable when you want auto-update.
# HF_HUB_OFFLINE=1
# Alternative: provide a token (free at https://huggingface.co/settings/tokens)
# HF_TOKEN=hf_xxx

# ── Model Configuration ───────────────────────────────────────────
# EMBEDDING_MODEL_NAME=BAAI/bge-m3
# GROQ_MODEL_NAME=llama-3.1-8b-instant
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# GROQ_API_URL="https://api.groq.com/openai/v1/chat/completions"

# ── Gemini Specific ───────────────────────────────────────────────
# GEMINI_MODEL_NAME=gemini-2.0-flash
# GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta/models

# ── LLM Chain Configuration (N5) ──────────────────────────────────
# LLM_CHAIN=groq_70b,qwen_32b,groq_8b,groq_scout

# ── Generation Limits ─────────────────────────────────────────────
# LLM_ACTIVITIES_PER_CALL=10
# LLM_N5_TARGET_COUNT=10
# TOP_K_LOCATIONS=5
# TOP_K_ACTIVITIES=5

# ── Server Settings (N8) ──────────────────────────────────────────
# API_HOST=0.0.0.0
# API_PORT=5000
# API_DEBUG=False
# ALLOWED_ORIGINS=http://localhost:8501,http://localhost:8502