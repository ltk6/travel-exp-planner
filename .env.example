# ── API Keys ──────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=your-groq-api-key-here
INTERNAL_API_KEY=your-long-and-random-secret-here

# ── Model Settings ───────────────────────────────────────────────
# EMBEDDING_MODEL_NAME=BAAI/bge-m3
# GEMINI_MODEL_NAME=gemini-2.0-flash
# GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta/models
# GROQ_MODEL_NAME=llama-3.1-8b-instant
# GROQ_8B_MODEL=llama-3.1-8b-instant
# GROQ_70B_MODEL=llama-3.3-70b-versatile
# GROQ_SCOUT_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# ── LLM Provider Routing (N5) ─────────────────────────────────────
# LLM_PROVIDER=gemini
# LLM_FALLBACK=groq_8b,groq_70b,groq_scout

# ── Activity Generation Limits (N5) ───────────────────────────────
# LLM_ACTIVITIES_PER_CALL=10
# LLM_N5_TARGET_COUNT=10
# LLM_MAX_RETRIES=2
# LLM_RETRY_WAIT_BASE=2.0

# ── Recommendation Limits (N4/N6) ─────────────────────────────────
# TOP_K_LOCATIONS=5
# TOP_K_ACTIVITIES=5

# ── Database ──────────────────────────────────────────────────────
PG_URI="postgresql://user:password@host:5432/dbname"

# ── API Server (N8) ───────────────────────────────────────────────
# API_HOST=0.0.0.0
# API_PORT=5000
# API_DEBUG=False
# ALLOWED_ORIGINS=http://localhost:8501,http://localhost:8502,http://127.0.0.1:8501,http://127.0.0.1:8502
# USER_AGENT=travel-exp-planner/1.0
