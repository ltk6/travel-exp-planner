XAI_API_KEY=your-xai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=your-groq-api-key-here

PG_URI="postgresql://user:password@host:5432/dbname"

# LLM routing (N5). Primary: "gemini" | "groq". Fallback: csv, để trống = auto.
LLM_PROVIDER=gemini
LLM_FALLBACK=groq

INTERNAL_API_KEY=your-long-and-random-secret-here

